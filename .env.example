# AICADBridge yapılandırma örneği
# Bu dosyayı ".env" olarak kopyalayın (cp .env.example .env) ve değerleri doldurun.
# Öncelik: gerçek ortam değişkenleri > .env > kod içi varsayılanlar.
# NOT: Yorum satırları kendi satırında olmalı; değer içinde "#" kullanmayın.

# ---------------------------------------------------------------------------
# Üretim hattı (İki Aşamalı: Planner -> Coder) model ayarları
# ---------------------------------------------------------------------------
# Planner: kullanıcı komutunu JSON feature planına çeviren aşama.
#   Hızlı/ucuz bir model iyi çalışır (çıktısı kısa bir JSON'dur).
# Coder: planın her adımı için Fusion 360 Python kodu üreten aşama.
#   Kod üretimi zor olduğundan güçlü bir model önerilir.
#
# Boş bırakırsanız her iki aşama da sohbet (ana) modelini kullanır.
# PROVIDER değerleri: openai | anthropic | google | groq | openrouter |
#                    deepseek | ollama | local
# MODEL değerine KENDİ SAĞLAYICINIZIN GÜNCEL MODEL ADINI girin
# (model adları sık değişir; sağlayıcının konsolundan güncel adı kopyalayın).

AICAD_PLANNER_PROVIDER=
AICAD_PLANNER_MODEL=
AICAD_CODER_PROVIDER=
AICAD_CODER_MODEL=

# ---------------------------------------------------------------------------
# Yanıt uzunluğu sınırları (token)
# ---------------------------------------------------------------------------
# Anthropic çağrılarında maksimum yanıt uzunluğu. Uzun CAD kodları için
# yüksek tutulur. Varsayılan: 16384
AICAD_MAX_TOKENS=16384

# Vision doğrulama (viewport ekran görüntüsü kontrolü) yanıt uzunluğu.
# Varsayılan: 4096
AICAD_VISION_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Anthropic yedek model listesi
# ---------------------------------------------------------------------------
# Tarayıcı CORS nedeniyle Anthropic model listesi çekilemezse arayüzde
# gösterilecek yedek liste: virgülle ayrılmış model id'leri.
# Örnek (kendi sağlayıcının güncel model adlarını girin):
# AICAD_ANTHROPIC_MODELS=model-adi-1,model-adi-2
# Boş bırakılırsa liste yok demektir; kullanıcı model adını arayüzden elle girer.
AICAD_ANTHROPIC_MODELS=

# ---------------------------------------------------------------------------
# API anahtarları (isteğe bağlı)
# ---------------------------------------------------------------------------
# UI, anahtarları tarayıcı yerel deposunda (localStorage) tutar; buraya yazarsanız
# Python tarafında çalışan eski akışlar (worker fallback) da kullanabilir.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
